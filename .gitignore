# ---- Python ----
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ---- Secrets and local configuration: NEVER commit ----
.env
.env.*
*.pem
*.key
secret_key

# ---- Runtime data: NEVER commit (holds the SQLite DB, the Flask secret key
#      and every uploaded bill image, i.e. real user data) ----
instance/

# SQLite databases and their journal / write-ahead-log side files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ...but the pre-built demo database IS committed on purpose: the free hosting tier
# has no persistent disk, so the app restores this copy on every cold start
# (IRIS_DEMO_SEED=1). It holds only the demo account - no real user data.
# Rebuild it with:
#   $env:IRIS_INSTANCE="<repo>\demo_seed"; python tools/seed_demo.py --reset
#   then delete demo_seed/secret_key
!demo_seed/iris.db

# ---- Generated test data (deterministic: regenerate with
#      `python tools/gen_receipts.py data_synth`) ----
data_synth/

# ---- Browser-test output (tools/browser_check.py uses Playwright) ----
test-results/
playwright-report/

# ---- College report (not part of the prototype) ----
# The ~30-page PDF report and its whole ReportLab build system exist only for
# the college submission, so they stay out of the repository. Keep a backup of
# report/ outside the repo: its hand-drawn diagrams (report/fig/arch.png,
# dfd1.png, er.png, flowchart.png, pipeline.png, preproc.png, usecase.png)
# have no generator script and cannot be rebuilt from this code.
report/
AI_Invoice_Receipt_Intelligence_Mini_Project_Report.pdf
*_Mini_Project_Report.pdf

# ---- Exports produced while using the app ----
iris_export*.csv
iris_report*.pdf

# ---- Logs, scratch and backup files ----
*.log
*.tmp
*.bak
*.orig
tmp/
scratch/

# ---- Editors, assistants and OS junk ----
.vscode/
.idea/
*.code-workspace
*.swp
*~
.claude/
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
